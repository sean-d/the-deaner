"╭ Keys ────────────────────────────────╮"
"│Navigate                              │"
"│j / ↓    Move down                    │"
"│k / ↑    Move up                      │"
"│g / Home Jump to top                  │"
"│G / End  Jump to bottom               │"
"│Enter    Open workspace in the        │"
"│terminal (starts or unparks it)       │"
"│Space    Collapse / expand repo       │"
"│/        Filter by repo or branch (Esc│"
"│clears)                               │"
"│                                      │"
"│Workspaces                            │"
"│w        New worktree + session for a │"
"│branch                                │"
"│t        New tab (agent, editor,      │"
"│shell)                                │"
"│a        Open a project: browse       │"
"│folders, add and start it             │"
"│x        Archive worktree / forget    │"
"│repo (asks first)                     │"
"│P        Park: save and stop the      │"
"│session                               │"
"│S        Save a snapshot now          │"
"│                                      │"
"│Pins                                  │"
"│p        Pin / unpin repo             │"
"│K        Move pinned repo up          │"
"│J        Move pinned repo down        │"
"╰──────────────────────────────────────╯"
